# ============================================================
# Fairmacs LMS - Example Backend Configuration
# Copy this file to application.properties or application-local.properties
# and supply your actual environment values.
# NEVER commit real credentials, passwords, or secrets to Git.
# ============================================================

# Server Configuration
server.port=8080
spring.application.name=fairmacs-lms

# Zoho WorkDrive Integration (OAuth 2.0)
zoho.client-id=${ZOHO_CLIENT_ID:your_zoho_client_id}
zoho.client-secret=${ZOHO_CLIENT_SECRET:your_zoho_client_secret}
zoho.redirect-uri=${ZOHO_REDIRECT_URI:https://fairmacs-lms-api.onrender.com/api/integrations/zoho/callback}
zoho.accounts-url=${ZOHO_ACCOUNTS_URL:https://accounts.zoho.com}
zoho.api-base-url=${ZOHO_API_BASE_URL:https://www.zohoapis.com/workdrive}
zoho.download-base-url=${ZOHO_DOWNLOAD_BASE_URL:https://download.zoho.com}
zoho.course-documents-folder-id=${ZOHO_COURSE_DOCUMENTS_FOLDER_ID:your_zoho_folder_id}
# Zoho WorkDrive Course Thumbnails Destination Folder
# Web URL: https://workdrive.zoho.com/folder/k3kdv441a3f090a3d4cb183ee44f638c0daee
zoho.course-thumbnails-folder-id=${ZOHO_COURSE_THUMBNAILS_FOLDER_ID:k3kdv441a3f090a3d4cb183ee44f638c0daee}

# Zoho Token Encryption (AES-256 Key in Base64)
# ZOHO_TOKEN_ENCRYPTION_KEY=base64_encoded_32_byte_aes_key

# PostgreSQL / Supabase Database Configuration
spring.datasource.url=${SUPABASE_DB_URL:jdbc:postgresql://your-db-host:5432/postgres}
spring.datasource.username=${SUPABASE_DB_USERNAME:postgres}
spring.datasource.password=${SUPABASE_DB_PASSWORD:your_db_password}
spring.datasource.driver-class-name=org.postgresql.Driver
spring.datasource.hikari.maximum-pool-size=${DB_MAX_POOL_SIZE:5}
spring.datasource.hikari.minimum-idle=${DB_MIN_IDLE:1}
spring.datasource.hikari.idle-timeout=300000
spring.datasource.hikari.max-lifetime=600000

# Flyway Versioned Database Migrations
spring.flyway.enabled=${FLYWAY_ENABLED:true}
spring.flyway.locations=classpath:db/migration
spring.flyway.baseline-on-migrate=${FLYWAY_BASELINE_ON_MIGRATE:true}
spring.flyway.baseline-version=${FLYWAY_BASELINE_VERSION:1}

# JPA / Hibernate (Use 'validate' in production and standard dev; migrations own DDL)
spring.jpa.hibernate.ddl-auto=${JPA_DDL_AUTO:validate}
spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.show-sql=${JPA_SHOW_SQL:false}
spring.jpa.properties.hibernate.format_sql=${JPA_FORMAT_SQL:false}

# JWT Configuration (Must be a high-entropy secret >= 32 bytes / 256 bits)
jwt.secret=${JWT_SECRET}
jwt.expiration=${JWT_EXPIRATION_MS:86400000}

# Login Abuse & Account Lockout Protection
app.security.login.max-attempts=${LOGIN_MAX_ATTEMPTS:5}
app.security.login.ip-max-attempts=${LOGIN_IP_MAX_ATTEMPTS:20}
app.security.login.lockout-minutes=${LOGIN_LOCKOUT_MINUTES:15}
app.security.login.max-tracked-entries=${LOGIN_MAX_TRACKED_ENTRIES:10000}

# Sample Data Seeding (Disabled by default; requires 'local' profile + explicit true)
app.seed.sample-users.enabled=${APP_SEED_SAMPLE_USERS_ENABLED:false}
app.seed.sample-users.initial-password=${APP_SEED_SAMPLE_USERS_INITIAL_PASSWORD:}
app.seed.sample-users.must-change-password=${APP_SEED_SAMPLE_USERS_MUST_CHANGE_PASSWORD:true}

# File Upload Configuration
spring.servlet.multipart.enabled=true
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

# CORS Configuration
cors.allowed-origins=${CORS_ALLOWED_ORIGINS:http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175}
cors.allowed-methods=GET,POST,PUT,PATCH,DELETE,OPTIONS
cors.allowed-headers=Authorization,Content-Type,Accept,Origin
cors.allow-credentials=true

# ============================================================
# Notification System & Scheduled Reminders Configuration
# ============================================================
app.notifications.frontend-base-url=${FRONTEND_BASE_URL:http://localhost:5173}
app.notifications.scheduler.enabled=${NOTIFICATION_SCHEDULER_ENABLED:true}
app.notifications.scheduler.timezone=${NOTIFICATION_TIMEZONE:Asia/Kolkata}
app.notifications.scheduler.reminder-days=${NOTIFICATION_REMINDER_DAYS:7,3,0}
app.notifications.scheduler.overdue-repeat-days=${NOTIFICATION_OVERDUE_REPEAT_DAYS:7}
app.notifications.scheduler.deadline-cron=${NOTIFICATION_DEADLINE_CRON:0 0 8 * * *}
app.notifications.scheduler.retake-cron=${NOTIFICATION_RETAKE_CRON:0 15 * * * *}
app.notifications.scheduler.digest-cron=${NOTIFICATION_DIGEST_CRON:0 30 8 * * MON}

# ============================================================
# Future Zoho Email Notification Channel (DISABLED BY DEFAULT)
# Keep app.notifications.email.enabled=false until Zoho ZeptoMail
# or Zoho Mail SMTP credentials are configured and verified.
# ============================================================
app.notifications.email.enabled=${NOTIFICATION_EMAIL_ENABLED:false}
app.notifications.email.provider=${NOTIFICATION_EMAIL_PROVIDER:ZEPTOMAIL}
app.notifications.email.from-address=${NOTIFICATION_EMAIL_FROM:no-reply@fairmacs.com}
app.notifications.email.from-name=${NOTIFICATION_EMAIL_FROM_NAME:Fairmacs Learning Academy}
app.notifications.email.reply-to=${NOTIFICATION_EMAIL_REPLY_TO:fla@fairmacs.com}
app.notifications.email.max-retries=${NOTIFICATION_EMAIL_MAX_RETRIES:3}
app.notifications.email.connect-timeout-seconds=${NOTIFICATION_EMAIL_CONNECT_TIMEOUT:10}
app.notifications.email.request-timeout-seconds=${NOTIFICATION_EMAIL_REQUEST_TIMEOUT:15}
app.notifications.email.base-backoff-seconds=${NOTIFICATION_EMAIL_BASE_BACKOFF:30}
app.notifications.email.poll-interval-ms=${NOTIFICATION_EMAIL_POLL_INTERVAL_MS:30000}
app.notifications.email.zeptomail.api-url=${ZEPTOMAIL_API_URL:https://api.zeptomail.in/v1.1/email}
app.notifications.email.zeptomail.send-token=${ZEPTOMAIL_SEND_TOKEN:}
app.notifications.email.smtp.host=${ZOHO_SMTP_HOST:smtp.zoho.in}
app.notifications.email.smtp.port=${ZOHO_SMTP_PORT:587}
app.notifications.email.smtp.username=${ZOHO_SMTP_USERNAME:}
app.notifications.email.smtp.password=${ZOHO_SMTP_PASSWORD:}

# Safe Production Logging Defaults (Never log SQL bind values, secrets, or tokens)
logging.level.org.springframework.web=INFO
logging.level.org.hibernate=INFO
logging.level.org.hibernate.SQL=WARN
logging.level.org.hibernate.orm.jdbc.bind=WARN
logging.level.org.springframework.security=INFO
logging.level.org.springframework.security.authorization=INFO
logging.level.com.fairmacs.lms=INFO
